{
  "description": "Shipyard guardrails. Every hook exits 0 at once unless agent_type starts with 'shipyard:', so normal sessions are never affected.",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {"type": "command", "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/hooks/scripts/protect-branches.py\"", "timeout": 10},
          {"type": "command", "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/hooks/scripts/readonly-bash.py\"", "timeout": 10},
          {"type": "command", "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/hooks/scripts/write-scope.py\"", "timeout": 10},
          {"type": "command", "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/hooks/scripts/test-plan-gate.py\"", "timeout": 10}
        ]
      },
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit",
        "hooks": [
          {"type": "command", "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/hooks/scripts/write-scope.py\"", "timeout": 10},
          {"type": "command", "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/hooks/scripts/test-plan-gate.py\"", "timeout": 10},
          {"type": "command", "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/hooks/scripts/secrets-guard.py\"", "timeout": 10}
        ]
      },
      {
        "matcher": "Read|Grep|Glob",
        "hooks": [
          {"type": "command", "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/hooks/scripts/goldfish-blinders.py\"", "timeout": 10}
        ]
      },
      {
        "matcher": "Agent|Task",
        "hooks": [
          {"type": "command", "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/hooks/scripts/brief-check.py\"", "timeout": 10}
        ]
      }
    ],
    "SubagentStart": [
      {
        "matcher": "shipyard:(code|security|contract|integration|reliability|simplicity)-reviewer",
        "hooks": [
          {"type": "command", "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/hooks/scripts/findings-gate.py\"", "timeout": 10}
        ]
      }
    ],
    "SubagentStop": [
      {
        "matcher": "shipyard:(code|security|contract|integration|reliability|simplicity)-reviewer",
        "hooks": [
          {"type": "command", "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/hooks/scripts/findings-gate.py\"", "timeout": 10}
        ]
      }
    ]
  }
}
