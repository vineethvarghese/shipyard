{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://shipyard.dev/contracts/architect-result.schema.json",
  "title": "Architect result",
  "description": "Return block of the architect (DRAFT, CRITIQUE, CONFORMANCE, ADJUDICATE, REVALIDATE).",
  "x-contract-version": "1.0.0",
  "type": "object",
  "properties": {
    "mode": {
      "type": "string",
      "enum": [
        "DRAFT",
        "CRITIQUE",
        "CONFORMANCE",
        "ADJUDICATE",
        "REVALIDATE"
      ]
    },
    "verdict": {
      "type": "string",
      "enum": [
        "SOUND",
        "NEEDS_CHANGES",
        "UNDERSPECIFIED",
        "CONSISTENT",
        "INCONSISTENT",
        "RESOLVED",
        "ESCALATE",
        "VALID",
        "UPDATE",
        "ARCHITECTURE_DECISION"
      ]
    },
    "findingsFile": {
      "type": [
        "string",
        "null"
      ]
    },
    "counts": {
      "type": "object",
      "properties": {
        "BLOCKING": {
          "type": "integer",
          "minimum": 0
        },
        "MAJOR": {
          "type": "integer",
          "minimum": 0
        },
        "MINOR": {
          "type": "integer",
          "minimum": 0
        },
        "NOTE": {
          "type": "integer",
          "minimum": 0
        }
      },
      "required": [
        "BLOCKING",
        "MAJOR",
        "MINOR",
        "NOTE"
      ],
      "additionalProperties": false
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "description": "<reviewer-short>-NNN, e.g. code-007"
          },
          "severity": {
            "type": "string",
            "enum": [
              "BLOCKING",
              "MAJOR",
              "MINOR",
              "NOTE"
            ]
          },
          "category": {
            "type": "string"
          },
          "location": {
            "type": "string",
            "description": "path:line-range | 'PR metadata' | 'whole slice' | planning artifact path"
          },
          "finding": {
            "type": "string",
            "description": "What is wrong, stated as a fact"
          },
          "whyItMatters": {
            "type": "string"
          },
          "evidence": {
            "type": "string",
            "minLength": 1,
            "description": "Code, command output, contract, ADR or doc reference a human can open. Mandatory"
          },
          "requiredResolution": {
            "type": "string",
            "description": "The minimum change that clears the finding"
          },
          "confidence": {
            "type": "string",
            "enum": [
              "HIGH",
              "MEDIUM",
              "LOW"
            ]
          },
          "owner": {
            "type": "string",
            "enum": [
              "implementer",
              "verifier",
              "architect",
              "planner",
              "human"
            ]
          },
          "reporters": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "status": {
            "type": "string",
            "enum": [
              "OPEN",
              "FIXED",
              "REBUTTED",
              "ACCEPTED_BY_HUMAN"
            ]
          }
        },
        "required": [
          "id",
          "severity",
          "category",
          "location",
          "finding",
          "whyItMatters",
          "evidence",
          "requiredResolution",
          "confidence",
          "owner",
          "reporters",
          "status"
        ],
        "additionalProperties": false
      }
    },
    "abstractionsChallenged": {
      "type": "integer",
      "minimum": 0
    },
    "abstractionsRejected": {
      "type": "integer",
      "minimum": 0
    },
    "invariantsChanged": {
      "type": "integer",
      "minimum": 0
    },
    "decisionRecord": {
      "type": [
        "string",
        "null"
      ],
      "description": "Path to an ADR written, or null"
    },
    "humanInputRequested": {
      "type": [
        "object",
        "null"
      ],
      "properties": {
        "question": {
          "type": "string"
        },
        "evidence": {
          "type": "string"
        },
        "recommendation": {
          "type": "string"
        },
        "blocked": {
          "type": "string"
        }
      },
      "required": [
        "question",
        "evidence",
        "recommendation",
        "blocked"
      ],
      "additionalProperties": false,
      "description": "HUMAN_INPUT_REQUESTED block for the coordinator, or null"
    }
  },
  "required": [
    "mode",
    "verdict",
    "findingsFile",
    "counts",
    "findings",
    "abstractionsChallenged",
    "abstractionsRejected",
    "invariantsChanged",
    "decisionRecord",
    "humanInputRequested"
  ],
  "additionalProperties": false
}
