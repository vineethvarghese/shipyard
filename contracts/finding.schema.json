{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://shipyard.dev/contracts/finding.schema.json",
  "title": "Finding",
  "description": "One review finding. Shared by every reviewer.",
  "x-contract-version": "1.0.0",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "description": "<reviewer-short>-NNN, e.g. code-007"
    },
    "severity": {
      "type": "string",
      "enum": [
        "BLOCKING",
        "MAJOR",
        "MINOR",
        "NOTE"
      ]
    },
    "category": {
      "type": "string"
    },
    "location": {
      "type": "string",
      "description": "path:line-range | 'PR metadata' | 'whole slice' | planning artifact path"
    },
    "finding": {
      "type": "string",
      "description": "What is wrong, stated as a fact"
    },
    "whyItMatters": {
      "type": "string"
    },
    "evidence": {
      "type": "string",
      "minLength": 1,
      "description": "Code, command output, contract, ADR or doc reference a human can open. Mandatory"
    },
    "requiredResolution": {
      "type": "string",
      "description": "The minimum change that clears the finding"
    },
    "confidence": {
      "type": "string",
      "enum": [
        "HIGH",
        "MEDIUM",
        "LOW"
      ]
    },
    "owner": {
      "type": "string",
      "enum": [
        "implementer",
        "verifier",
        "architect",
        "planner",
        "human"
      ]
    },
    "reporters": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "status": {
      "type": "string",
      "enum": [
        "OPEN",
        "FIXED",
        "REBUTTED",
        "ACCEPTED_BY_HUMAN"
      ]
    }
  },
  "required": [
    "id",
    "severity",
    "category",
    "location",
    "finding",
    "whyItMatters",
    "evidence",
    "requiredResolution",
    "confidence",
    "owner",
    "reporters",
    "status"
  ],
  "additionalProperties": false
}
